# Production image for Frappe LMS, built on the laptop from a clean export of a git ref.
# The build context is the exported tree (see scripts/deploy/deploy.sh build).
#
# Stage 1 (builder) uses frappe/bench, which has bench, Python and Node for the build.
# Stage 2 (runtime) is a slim Debian image. It copies only what the app needs at run
# time: the Python install and the Node install at the same paths the virtualenv
# uses, and the finished frappe-bench. Build tools and caches stay in the builder.

ARG FRAPPE_BRANCH=develop
ARG UV_DEFAULT_INDEX=https://pypi.org/simple
ARG LMS_VERSION=unknown

# ---------------------------------------------------------------- builder
FROM frappe/bench:latest AS builder

ARG FRAPPE_BRANCH
ARG UV_DEFAULT_INDEX

USER frappe
WORKDIR /home/frappe

# Frappe develop needs the Node version the base image provides for it (as in docker/init.sh).
ENV PATH="${NVM_DIR}/versions/node/v${NODE_VERSION_DEVELOP}/bin/:${PATH}"
ENV UV_DEFAULT_INDEX=${UV_DEFAULT_INDEX}

# Frappe and payments do not depend on the LMS source, so this layer is reused from the
# cache until FRAPPE_BRANCH or the base image changes. This is the slow step.
RUN bench init --skip-redis-config-generation --skip-assets --frappe-branch "${FRAPPE_BRANCH}" frappe-bench \
 && cd frappe-bench \
 && bench get-app payments \
 && bench build --app frappe

# Raven (chat, and the server side of the Raven mobile app), pinned to a tested commit so a
# rebuild never picks up an untested change. It does not depend on the LMS source, so this
# layer stays cached across LMS deploys. Declared here so a new RAVEN_REF only rebuilds from here.
ARG RAVEN_REF=e2ae015c1533029b2b0d9c935645f94ebe16c112
RUN --mount=type=cache,target=/home/frappe/.cache/yarn,uid=1000,gid=1000 \
    cd frappe-bench \
 && git init -q apps/raven \
 && git -C apps/raven fetch -q --depth 1 https://github.com/frappe/raven "${RAVEN_REF}" \
 && git -C apps/raven checkout -q FETCH_HEAD \
 && ./env/bin/python -m pip install --quiet -e apps/raven \
 && (grep -qx raven sites/apps.txt || { [ -n "$(tail -c1 sites/apps.txt)" ] && echo >> sites/apps.txt; echo raven >> sites/apps.txt; }) \
 && (cd apps/raven && yarn install --check-files) \
 && bench build --app raven \
 && rm -rf apps/raven/node_modules apps/raven/apps/web/node_modules apps/raven/apps/native/node_modules

# The LMS source is the only part that changes between deploys, so it comes last.
COPY --chown=frappe:frappe lms-src /home/frappe/frappe-bench/apps/lms

# Declared here, not at the top of the stage: BuildKit passes declared build args into
# every later RUN, so a new LMS version would otherwise invalidate the Frappe layer too.
ARG LMS_VERSION

# The yarn cache mount keeps package downloads between builds.
RUN --mount=type=cache,target=/home/frappe/.cache/yarn,uid=1000,gid=1000 \
    cd frappe-bench \
 && ./env/bin/python -m pip install --quiet -e apps/lms \
 && (grep -qx lms sites/apps.txt || { [ -n "$(tail -c1 sites/apps.txt)" ] && echo >> sites/apps.txt; echo lms >> sites/apps.txt; }) \
 && (cd apps/lms && yarn install --check-files) \
 && bench build --app lms \
 && echo "${LMS_VERSION}" > /home/frappe/frappe-bench/.lms-version \
 && cp sites/apps.txt apps.txt.image

# Clean up: build-only Node toolchains (assets are already built), dependency caches and Git
# history are not needed at run time. apps/frappe/node_modules stays: socketio needs socket.io.
# The Node install is the one the node on the PATH resolves to, copied with its links dereferenced.
RUN NODE_HOME="$(dirname "$(dirname "$(readlink -f "$(command -v node)")")")" \
 && cp -aL "${NODE_HOME}" /home/frappe/node \
 && rm -rf /home/frappe/frappe-bench/apps/lms/frontend/node_modules \
           /home/frappe/frappe-bench/apps/lms/frontend/.cache \
           /home/frappe/frappe-bench/apps/frappe/island-toolchain/node_modules \
           /home/frappe/frappe-bench/apps/frappe/flow/node_modules \
           /home/frappe/frappe-bench/apps/frappe/studio/frontend/node_modules \
 && find /home/frappe/frappe-bench/apps /home/frappe/frappe-bench/env -name .git -prune -exec rm -rf {} + \
 && find /home/frappe/frappe-bench /home/frappe/.pyenv -name __pycache__ -prune -exec rm -rf {} + \
 && rm -rf /home/frappe/.cache /home/frappe/.npm /home/frappe/.yarn /home/frappe/.local/share/uv

# ---------------------------------------------------------------- runtime
FROM debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8

# Runtime libraries for Python packages (mysqlclient, Pillow, cairo) and general tools.
# wkhtmltopdf is not packaged for Debian trixie; PDF generation needs it installed separately. Build packages are not installed here.
RUN apt-get -o Acquire::Retries=5 update \
 && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
      ca-certificates curl git tini mariadb-client nginx \
      libmariadb3 libcairo2 libpango-1.0-0 libpangocairo-1.0-0 libgdk-pixbuf-2.0-0 \
      libjpeg62-turbo libxrender1 libxext6 fontconfig fonts-dejavu-core \
      libffi8 libssl3t64 libsqlite3-0 libbz2-1.0 liblzma5 libreadline8t64 zlib1g libncursesw6 \
 && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --uid 1000 --shell /bin/bash frappe

# nginx for the "frontend" container, which serves /assets and /files (see nginx.conf).
COPY --chmod=644 nginx.conf /home/frappe/nginx.conf
COPY --chmod=755 entrypoint.sh /usr/local/bin/lms-entrypoint

# Same paths as the builder, so the virtualenv's links to Python still resolve.
COPY --from=builder --chown=frappe:frappe /home/frappe/.pyenv /home/frappe/.pyenv
COPY --from=builder --chown=frappe:frappe /home/frappe/node /home/frappe/node
COPY --from=builder --chown=frappe:frappe /home/frappe/frappe-bench /home/frappe/frappe-bench
# The bench command itself (installed for the user in the builder).
COPY --from=builder --chown=frappe:frappe /home/frappe/.local /home/frappe/.local
COPY --from=builder --chown=frappe:frappe /home/frappe/.bench /home/frappe/.bench

ENV PATH="/home/frappe/node/bin:/home/frappe/.local/bin:/home/frappe/frappe-bench/env/bin:${PATH}"
ARG LMS_VERSION
ENV LMS_VERSION=${LMS_VERSION}

USER frappe
WORKDIR /home/frappe/frappe-bench

# Smoke test: fails the build if the copied Python, Node or the app do not start.
RUN node --version \
 && mariadb --version \
 && node -e "require('/home/frappe/frappe-bench/apps/frappe/node_modules/socket.io')" \
 && python -c "import frappe, MySQLdb, raven; print('frappe', frappe.__version__, 'raven', raven.__version__)" \
 && bench --version \
 && nginx -v \
 && test -f sites/assets/assets.json \
 && test -n "$(ls sites/assets/lms/frontend/assets/*.css)" \
 && test -f apps/raven/raven/www/raven.html \
 && cmp -s apps.txt.image sites/apps.txt

# Keep the built assets outside sites/ (a volume); lms-entrypoint links
# sites/assets to them on every start, so a deploy never serves stale CSS or JS.
RUN mv sites/assets built-assets && ln -s ../built-assets sites/assets

EXPOSE 8000 8080 9000
ENTRYPOINT ["tini", "--", "lms-entrypoint"]
CMD ["bench", "--version"]
