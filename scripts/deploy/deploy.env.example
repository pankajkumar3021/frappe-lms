# Copy to scripts/deploy/deploy.env and fill in. This file stays on your laptop and is
# git-ignored. Secrets (database and admin passwords) are never written here.

# SSH target for the production server (must already accept your key).
DEPLOY_HOST=user@your-server.example.com

# Where the stack lives on the server.
DEPLOY_DIR=/opt/lms

# The site's name. Use the public domain, for example lms.example.com.
SITE_NAME=lms.example.com

# Git ref to build. Default main.
REF=main

# Where the image is built. server (default): the server fetches the commit from
# GitHub and builds it, so no image is uploaded. laptop: build here and copy the
# image over SSH (about 1 GB per deploy).
BUILD_ON=server

# Repository the server clones. Default: this checkout's origin (an SSH GitHub
# URL is turned into HTTPS, since the server clones anonymously).
REPO_URL=

# Local image name. The tag is the commit SHA.
IMAGE_REPO=lms-prod

# Target platform of the server.
PLATFORM=linux/amd64

# Laptop builds only. Docker network for the image build; host avoids flaky DNS.
BUILD_NETWORK=host

# Laptop builds only. Python package index for the build. Leave blank for pypi.org. A closer mirror makes
# the first build much faster when pypi.org is slow from your network.
UV_DEFAULT_INDEX=
